<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permissions: only RECEIVE_SMS and POST_NOTIFICATIONS, both requested at the moment the user
         switches a shield ON (or taps "Fix" in Shield health). No READ_SMS (we never read the inbox), no
         READ_CALL_LOG, no READ_CONTACTS, no READ_PHONE_STATE. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Display over other apps": a small card naming an unknown caller while the phone rings. Nothing is granted
         at install; the user switches it on in Settings from Shield health, and can switch the card off in the app.
         The card is our own window only; it can't read the screen or other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Internet is used for an optional "Deep check" of a link (just the link is sent), community reports, and the
         ads that keep the app free (Google AdMob; ad requests carry no app content). SMS text, callers' numbers and
         contacts are never sent by the app (a "Chat on WhatsApp" tap hands that one number to WhatsApp or the
         browser). Cleartext (http://) traffic is blocked below. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional app lock (fingerprint / face / phone PIN) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="Second Look"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- AdMob app id (set by tool/setup.sh from ADMOB_APP_ID_ANDROID; Google's test id otherwise) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ADMOB_APP_ID_ANDROID_PLACEHOLDER" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share any text or link to Second Look to check it -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share a payment screenshot to Second Look. Read on the phone only (ML Kit, bundled models).
                 No storage/media permission: the sending app grants access to just this one image, and
                 the in-app picker uses Android's Photo Picker. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- SMS Shield. Disabled until the user switches it ON (then enabled in code), so when it is OFF
             the app cannot receive SMS at all. -->
        <receiver
            android:name=".SmsReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Call Shield: Android's caller ID & spam role (Android 10+). Android only sends us calls from
             numbers that are NOT in the user's contacts, and only after the user picks Second Look. Numbers the
             user blocked in Second Look are rejected; nothing else is ever stopped. -->
        <service
            android:name=".ScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>

    <queries>
        <!-- "Chat on WhatsApp" button: only to know whether it's installed -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Phone makers' "autostart" settings screens (Shield health opens them so the shields keep running) -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.huawei.systemmanager" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Reading results aloud with the phone's own text-to-speech -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
